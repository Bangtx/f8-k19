{
  "compilerOptions": {
    // Sửa 2 dòng này:
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Các phần bên dưới giữ nguyên
    "target": "ES2022",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "skipLibCheck": true
  }
}